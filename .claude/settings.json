    "CCOS_WORKSPACE_ROOT": "C:\\Users\\TONX\\DEVKIT\\projects\\ccdv\\ccdv",
    "CCOS_WRKOPS_DIR": "_wrkops/docs"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CCOS_PYTHON\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$CCOS_PYTHON\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_handoff.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "\"$CCOS_PYTHON\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_git.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$CCOS_PYTHON\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_genesis.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$CCOS_PYTHON\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/report_writer.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
