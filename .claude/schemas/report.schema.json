{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccos/wrkops/1.8/report.schema.json",
  "title": "WRKOPS 1.8 Report front-matter",
  "schema_version": "1.1.0",
  "type": "object",
  "required": [
    "task_id",
    "slug",
    "state",
    "version_stamp",
    "model",
    "date"
  ],
  "additionalProperties": true,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^t_[0-9]{8}_[a-z0-9]{4,}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9-]+)+$"
    },
    "state": {
      "enum": [
        "ATTEMPTED",
        "IMPLEMENTED",
        "VALIDATED",
        "COMMITTED",
        "SHIPPED",
        "BLOCKED",
        "FAILED",
        "ABORTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "version_stamp": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  }
}
