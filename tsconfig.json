{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "rootDirs": [".", "./.react-router/types"], "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"], "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "isolatedModules": true, "verbatimModuleSyntax": true
  },
  "include": ["app/**/*", "vite.config.ts", "react-router.config.ts", ".react-router/types/**/*"]
}
